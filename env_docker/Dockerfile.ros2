#
# ros2 コンテナ: HSR の ROS 2 スタック (MoveIt / nav2 / hsrb_* / tmc_*) + このリポジトリの launch。
#
# ROS 2 Jazzy (Ubuntu 24.04) 専用。Humble 構成は削除した (このブランチは Jazzy のみ)。
# Jazzy 版の構成は https://github.com/ry0hei-kobayashi/hsr-jazzy-docker を元にしている。
FROM ros:jazzy-ros-core

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

RUN rm -f /etc/apt/apt.conf.d/docker-clean; echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y git curl python-is-python3 g++ make libgflags-dev \
    python3-colcon-common-extensions \
    python3-numpy \
    python3-opencv \
    python3-psutil \
    libeigen3-dev \
    libpoco-dev \
    libboost-system-dev \
    libboost-filesystem-dev \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-rosidl-default-generators \
    ros-${ROS_DISTRO}-tf-transformations \
    ros-${ROS_DISTRO}-tf2 \
    ros-${ROS_DISTRO}-tf2-msgs \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    ros-${ROS_DISTRO}-actionlib-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-control-msgs \
    ros-${ROS_DISTRO}-trajectory-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-vision-msgs \
    ros-${ROS_DISTRO}-gazebo-msgs \
    ros-${ROS_DISTRO}-topic-tools \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-moveit \
    ros-${ROS_DISTRO}-moveit-ros-move-group \
    ros-${ROS_DISTRO}-moveit-ros-perception \
    ros-${ROS_DISTRO}-pinocchio \
    ros-${ROS_DISTRO}-nav2-map-server \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-depth-image-proc \
    ros-${ROS_DISTRO}-image-transport-plugins \
    ros-${ROS_DISTRO}-image-proc \
    ros-${ROS_DISTRO}-rviz-imu-plugin \
    ros-${ROS_DISTRO}-rqt-robot-steering \
    ros-${ROS_DISTRO}-rqt-tf-tree \
    ros-${ROS_DISTRO}-controller-interface \
    ros-${ROS_DISTRO}-realtime-tools \
    ros-${ROS_DISTRO}-action-tutorials-interfaces \
    ros-${ROS_DISTRO}-example-interfaces \
    ros-${ROS_DISTRO}-diagnostic-updater \
    ros-${ROS_DISTRO}-std-srvs \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    libode-dev \
    ipython3 \
    python3-stl \
    python3-rosdep

# HSR のワークスペース。hsr-project は distro 名 (jazzy) のブランチを持つ。
# tmc_wrs_gazebo は Jazzy 版が無いので ry0hei-kobayashi の fork (jazzy ブランチ) を使う。
RUN source /opt/ros/$ROS_DISTRO/setup.bash && \
    mkdir -p /ws/src && \
    cd /ws/src && \
    for r in hsrb_drivers tmc_drivers tmc_gazebo hsrb_simulator hsrb_controllers hsrb_control hsrb_moveit \
             hsr_common hsrb_launch hsrb_interfaces tmc_common tmc_common_msgs tmc_realtime_control \
             hsrb_manipulation tmc_manipulation tmc_manipulation_base tmc_manipulation_planner tmc_voice \
             hsrb_rosnav tmc_navigation tmc_teleop hsrb_teleop tmc_database hsrb_robot \
             pick_and_place_example instance_segmentation_msgs cv_bridge_util compressed_rgbd_msgs \
             tmc_point_cloud graspnet_ros hsrb_system_inspection; do \
        git clone -q -b ${ROS_DISTRO} https://github.com/hsr-project/${r}.git || exit 1; \
    done && \
    git clone -q -b main https://github.com/hsr-project/coordinate_transform_util_ros.git && \
    git clone -q -b ${ROS_DISTRO} https://github.com/hsr-project/hsrb_common.git && \
    git clone -q -b ${ROS_DISTRO} https://github.com/ry0hei-kobayashi/tmc_wrs_gazebo.git && \
    git clone -q -b ros2_csm_eigen https://github.com/AlexKaravaev/csm.git && \
    git clone -q -b main https://github.com/AlexKaravaev/ros2_laser_scan_matcher.git && \
    rm -rf hsrb_launch/hsrb_robot_launch && \
    rm -rf hsrb_gazebo_launch/tmc_grid_map_server && \
    rm -rf hsrb_simulator/hsrb_rviz_simulator && \
    rm -rf tmc_drivers/tmc_pgr_camera && \
    # ros2_laser_scan_matcher (main) は Humble 向け。Jazzy では tf2_geometry_msgs のヘッダが .hpp になった。
    grep -rl 'tf2_geometry_msgs/tf2_geometry_msgs.h\b' ros2_laser_scan_matcher | \
      xargs -r sed -i 's|tf2_geometry_msgs/tf2_geometry_msgs\.h\b|tf2_geometry_msgs/tf2_geometry_msgs.hpp|g' && \
    cd .. && \
    apt update -y && (rosdep init || true) && rosdep update --rosdistro $ROS_DISTRO && \
    rosdep install --ignore-src -r -y -i --from-paths src && \
    colcon build --symlink-install --continue-on-error --cmake-args -DCMAKE_BUILD_TYPE=Release --parallel-workers $(nproc)

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

RUN curl -sSL https://github.com/hsr-project/hsrb_rosnav/raw/refs/heads/master/hsrb_rosnav_config/maps/white_space/map.yaml -o /map.yaml
RUN curl -sSL https://github.com/hsr-project/hsrb_rosnav/raw/refs/heads/master/hsrb_rosnav_config/maps/white_space/white_space.pgm -o /white_space.pgm

ADD launch/hsr.launch.py /hsr.launch.py
ADD launch/teleop.launch.py /teleop.launch.py
ADD launch/hsrb_relay_topics.launch.xml /hsrb_relay_topics.launch.xml
ADD launch/hsrb_sensor_frames.launch.xml /hsrb_sensor_frames.launch.xml
ADD scripts/rgbd_republisher.py /rgbd_republisher.py
ADD scripts/reset_world_matcher_helper.py /reset_world_matcher_helper.py
ADD assets/hsr-omniverse.rviz /hsr-omniverse.rviz

COPY assets/cyclonedds.xml /cyclonedds.xml
ADD assets/ros_entrypoint.ros2.sh /ros_entrypoint.sh

CMD [ "ros2", "launch", "/hsr.launch.py" ]
