# Simple runtime image for executing sample-ycb-grasp.py under Isaac Sim
# The base image already includes Omniverse Isaac Sim 2023.1.1 and NVIDIA GPU dependencies.
FROM ros:humble-ros-core-jammy AS ros

FROM nvcr.io/nvidia/isaac-sim:2023.1.1

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND noninteractive

RUN apt update && \
    apt install -y --no-install-recommends \
    curl \
    wget \
    && apt -y autoremove \
    && apt clean autoclean

# install ROS dependencies
ENV ROS_DISTRO humble
#COPY --from=ros /ros_entrypoint.sh /
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" > /etc/apt/sources.list.d/ros2.list

RUN rm -f /etc/apt/apt.conf.d/docker-clean; echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y \
    git g++ make python-is-python3 python3-pip \
    python3-colcon-common-extensions \
    libeigen3-dev \
    libpoco-dev \
    libboost-system-dev \
    libboost-filesystem-dev \
    python3-pyassimp \
    ros-humble-ros2cli \
    ros-humble-ros2cli-common-extensions \
    ros-humble-rclpy \
    ros-humble-xacro \
    ros-humble-rosidl-default-generators \
    ros-humble-rclpy \
    ros-humble-tf-transformations \
    ros-humble-tf2 \
    ros-humble-tf2-msgs \
    ros-humble-tf2-geometry-msgs \
    ros-humble-tf2-ros-py \
    ros-humble-actionlib-msgs \
    ros-humble-geometry-msgs \
    ros-humble-control-msgs \
    ros-humble-trajectory-msgs \
    ros-humble-sensor-msgs \
    ros-humble-nav-msgs \
    ros-humble-vision-msgs \
    ros-humble-gazebo-msgs \
    ros-humble-moveit-msgs \
    ros-humble-controller-interface \
    ros-humble-realtime-tools \
    ros-humble-diagnostic-updater \
    ros-humble-std-srvs \
    ros-humble-action-tutorials-interfaces \
    ros-humble-example-interfaces \
    ros-humble-angles
RUN /isaac-sim/python.sh -m pip install transforms3d pyassimp

RUN source /opt/ros/$ROS_DISTRO/setup.bash && \
    mkdir -p /ws/src && \
    cd /ws/src && \
    git clone -b humble https://github.com/hsr-project/tmc_common_msgs.git && \
    git clone -b humble https://github.com/hsr-project/tmc_common.git && \
    git clone -b humble https://github.com/hsr-project/tmc_drivers.git && \
    git clone -b humble https://github.com/hsr-project/tmc_realtime_control.git && \
    git clone -b feature/ros2 https://github.com/hsr-project/tmc_wrs_gazebo.git && \
    git clone -b feature/ros2 https://github.com/hsr-project/tmc_gazebo_task_evaluators.git && \
    rm -rf tmc_drivers/tmc_pgr_camera && \
    cd .. && \
    colcon build
ADD assets/ros_entrypoint.ros2.sh /ros_entrypoint.sh

RUN curl -sSL https://raw.githubusercontent.com/NVIDIA-Omniverse/IsaacSim-ros_workspaces/main/humble_ws/fastdds.xml -o /fastdds.xml

ENV FASTRTPS_DEFAULT_PROFILES_FILE /fastdds.xml

WORKDIR /isaac-sim

# Copy the entire repository so the HSR helper modules, USD assets, and scripts are available.
COPY . /workspace

ENV NVIDIA_VISIBLE_DEVICES \
        ${NVIDIA_VISIBLE_DEVICES:-all}
ENV NVIDIA_DRIVER_CAPABILITIES all

ENV PYTHONUNBUFFERED 1

# Ensure the scripts dir is importable as a module (for `import hsr`).
ENV PYTHONPATH=/workspace/scripts:${PYTHONPATH}

ENTRYPOINT [ "/ros_entrypoint.sh" ]
CMD [ "/isaac-sim/python.sh", "/workspace/scripts/sample-ycb-grasp.py"]
