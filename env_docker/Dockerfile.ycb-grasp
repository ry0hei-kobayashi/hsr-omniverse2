# sample-ycb-grasp.py (YCB 物体を順に把持してみるサンプル) を Isaac Sim 5.1 / ROS 2 Jazzy で動かす
# ランタイムイメージ。本体イメージ hsr-omniverse-isaacsim:jazzy (env_docker/Dockerfile.isaacsim) の
# 上に、サンプルだけが要るもの (pyassimp と tmc_wrs_gazebo の STL メッシュ) を足す。
#
#   make build            # 先に本体イメージを作る
#   make ycb-grasp        # このイメージを build して実行 (docker-compose-ycb-grasp.yml)
#
# 旧版は Isaac Sim 2023.1.1 + apt の Humble を丸ごと入れていたが、5.1 では ROS は Isaac 同梱の
# rclpy (+ /app/ros_msgs) を使うので apt の ROS は不要。
FROM hsr-omniverse-isaacsim:jazzy

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
USER root

# pyassimp は libassimp.so を dlopen するだけなので、共有ライブラリだけ入れる。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libassimp5 \
    && rm -rf /var/lib/apt/lists/*
RUN /isaac-sim/python.sh -m pip install --no-cache-dir pyassimp

# 把持前に物体の大きさを STL から測る。メッシュは tmc_wrs_gazebo_worlds (ry0hei-kobayashi fork, jazzy) の
# models/ にある。USD (io/models/usd/wrs_models) とは別物なので、必要な models/ だけ sparse checkout する。
RUN git clone -q --depth 1 -b jazzy --filter=blob:none --sparse \
        https://github.com/ry0hei-kobayashi/tmc_wrs_gazebo.git /opt/tmc_wrs_gazebo \
    && cd /opt/tmc_wrs_gazebo && git sparse-checkout set tmc_wrs_gazebo_worlds/models \
    && rm -rf /opt/tmc_wrs_gazebo/.git
ENV WRS_MODELS_DIR=/opt/tmc_wrs_gazebo/tmc_wrs_gazebo_worlds/models

# サンプル本体。compose では同じパスに live mount するので編集が即反映される。
# サンプル本体は本体イメージの /app/sim (hsr_omniverse2_sim/samples/) に入っている。

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/isaac-sim/python.sh", "/app/sim/hsr_omniverse2_sim/samples/sample-ycb-grasp.py"]
