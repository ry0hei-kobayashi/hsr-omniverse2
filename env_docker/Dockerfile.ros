FROM ros:noetic-ros-core-focal

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND noninteractive

RUN apt update && \
    apt install -y git python-is-python3 g++ make libgflags-dev \
    python3-catkin-tools \
    libeigen3-dev libtf-dev \
    ros-noetic-moveit \
    ros-noetic-map-server \
    ros-noetic-dwa-local-planner \
    ros-noetic-move-base \
    ros-noetic-roslint \
    ros-noetic-eigen-conversions \
    ros-noetic-tf-conversions \
    ros-noetic-robot-state-publisher \
    ros-noetic-laser-scan-matcher \
    ros-noetic-depth-image-proc \
    ros-noetic-image-transport-plugins \
    ros-noetic-rviz-imu-plugin \
    ros-noetic-gazebo-msgs \
    ros-noetic-rqt-robot-plugins \
    && \
    apt clean

RUN source /opt/ros/$ROS_DISTRO/setup.bash && \
    mkdir -p /ws/src && \
    cd /ws/src && \
    catkin init && \
    git clone https://github.com/hsr-project/hsrb_description.git && \
    git clone https://github.com/hsr-project/hsrb_meshes.git && \
    git clone https://github.com/hsr-project/hsrb_moveit_config.git && \
    git clone https://github.com/hsr-project/tmc_control_msgs.git && \
    git clone https://github.com/TAMS-Group/bio_ik.git && \
    git clone https://github.com/devrt/mobile-manipulator-tools.git && \
    git clone https://github.com/hsr-project/hsrb_rosnav.git && \
    git clone https://github.com/hsr-project/tmc_gazebo_task_evaluators.git -b feature/gazeboless && \
    git clone https://github.com/hsr-project/tmc_wrs_gazebo.git && \
    git clone https://github.com/iris-ua/iris_lama.git && \
    git clone https://github.com/iris-ua/iris_lama_ros.git && \
    rm -rf mobile-manipulator-tools/cmd_vel_controller && \
    rm -rf mobile-manipulator-tools/loopback_robot_hardware && \
    cd .. && \
    catkin config --install && \
    catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ros/$ROS_DISTRO -DCATKIN_ENABLE_TESTING=0 && \
    catkin build && \
    cp -r src/hsrb_rosnav/hsrb_rosnav_config/maps /opt/ros/$ROS_DISTRO/share/hsrb_rosnav_config/maps && \
    cd / && \
    rm -rf /ws

ADD launch/hsr.launch /hsr.launch
ADD scripts/reset_world_matcher_helper.py /reset_world_matcher_helper.py
ADD assets/hsr-omniverse.rviz /hsr-omniverse.rviz

# reset_world (テレポート) 後に laser_scan_matcher_node を再起動するヘルパーを常駐させる。
# hsr-omniverse は ROS パッケージではなく roslaunch から絶対パスの node 起動ができないため、
# roslaunch を前景に保ちつつ helper をバックグラウンドで起動する。helper は rospy.init_node で
# master の起動を待つので起動順序は問わない。HSR_ROS_VERSION=1 で ROS1 分岐を選ぶ。
CMD ["/bin/bash", "-c", "HSR_ROS_VERSION=1 python3 /reset_world_matcher_helper.py & exec roslaunch /hsr.launch"]
