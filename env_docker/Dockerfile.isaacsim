#
# Isaac Sim 5.1 + ROS 2 Jazzy (Isaac 同梱の rclpy を使う。このブランチは Jazzy 専用)
#
# 版の前提:
#   * Isaac Sim 5.1.0 は Ubuntu 24.04 (noble) / Python 3.11。CUDA 12.8 以降の
#     ドライバ要件のため 4.5.0 は使わない。
#   * noble の apt にある ros-jazzy-* は Python 3.12 向けで、Isaac の 3.11 からは
#     rclpy の拡張 (.so) が読めない。
#   * Isaac 5.1 は /isaac-sim/exts/isaacsim.ros2.bridge/jazzy/ に Python 3.11 向けの
#     rclpy と rmw (cyclonedds / fastrtps) を同梱している。
#     → ROS は apt で入れず、同梱物に PYTHONPATH / LD_LIBRARY_PATH を通すだけ。
#
# 同梱に無いもの (msgbuild ステージで Python 3.11 向けに建てる):
#   * control_msgs          FollowJointTrajectory / GripperCommand (MoveIt ↔ sim)
#   * tmc_control_msgs      GripperApplyEffort (hsr-project/tmc_realtime_control)
#   * gazebo_msgs           /gazebo/get_world_properties 等の互換サービス
#   * tf_transformations    純 Python (DLu/tf_transformations) + transforms3d
#   * tmc_wrs_gazebo_worlds randomizer (純 Python, ry0hei-kobayashi/tmc_wrs_gazebo)
#   建てる場所 (ros:jazzy + python3.11 venv) と使う場所 (Isaac, py3.11) を分ける。
#   同梱 bridge には lib/ と rclpy/ しか無く CMake 側が丸ごと欠けているので、
#   Isaac コンテナの中ではメッセージを建てられない。手順は env_docker/build_ros_msgs_py311.sh。
#
# 実行ユーザ: ベースイメージは uid 1234 (isaac-sim) だが、ホストの
# ~/.hsr-omniverse/cache を bind mount して書くために root で走らせる
# (4.5 時代と同じ運用。キャッシュの mount 先も /root/... のまま)。

# ---------------------------------------------------------------------------
# stage 1: Python 3.11 向けに ROS メッセージを建てる
# ---------------------------------------------------------------------------
FROM ros:jazzy-ros-base AS msgbuild
ENV ROS_DISTRO=jazzy

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# python3-packaging: colcon 本体は 3.10 で走る。packaging が無いと起動時に落ちる。
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl git \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv \
        build-essential cmake \
        python3-colcon-common-extensions \
        python3-packaging \
        ros-${ROS_DISTRO}-rosidl-default-generators \
        ros-${ROS_DISTRO}-action-msgs \
        ros-${ROS_DISTRO}-trajectory-msgs \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-geometry-msgs \
        ros-${ROS_DISTRO}-std-msgs \
        ros-${ROS_DISTRO}-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

# 生成器を 3.11 で走らせるのに要る純 Python でない依存。
# system の python3.11 に直接 pip すると /usr/lib/python3/dist-packages の
# packaging を消して colcon (3.10) が起動しなくなるので venv に閉じ込める。
RUN python3.11 -m venv /py311 \
    && /py311/bin/pip install --no-cache-dir --upgrade pip \
    && /py311/bin/pip install --no-cache-dir empy==3.3.4 lark-parser numpy catkin_pkg

WORKDIR /ws/src
RUN git clone -q --depth 1 -b ${ROS_DISTRO} https://github.com/ros-controls/control_msgs.git \
    && git clone -q --depth 1 -b ${ROS_DISTRO} https://github.com/hsr-project/tmc_realtime_control.git \
    && git clone -q --depth 1 -b ros2 --filter=blob:none --sparse https://github.com/ros-simulation/gazebo_ros_pkgs.git \
    && (cd gazebo_ros_pkgs && git sparse-checkout set gazebo_msgs) \
    && git clone -q --depth 1 -b main https://github.com/DLu/tf_transformations.git \
    && git clone -q --depth 1 -b ${ROS_DISTRO} https://github.com/ry0hei-kobayashi/tmc_wrs_gazebo.git

COPY env_docker/build_ros_msgs_py311.sh /build_ros_msgs_py311.sh
RUN bash /build_ros_msgs_py311.sh

# ---------------------------------------------------------------------------
# stage 2: Isaac Sim 5.1
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/isaac-sim:5.1.0 AS isaac-sim

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# apt と /root 配下のキャッシュ書き込みのため root で走らせる (冒頭のコメント参照)。
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget git \
    && rm -rf /var/lib/apt/lists/*

# tf_transformations は transforms3d の薄い包み、randomizer は scipy を使う。
RUN /isaac-sim/python.sh -m pip install --no-cache-dir transforms3d scipy

# ---- ROS 2 Jazzy: Isaac 同梱物 + 自前で建てたメッセージ ---------------------
ENV ROS_DISTRO=jazzy \
    ROS_VERSION=2 \
    ISAAC_ROS2_BRIDGE=/isaac-sim/exts/isaacsim.ros2.bridge/jazzy
COPY --from=msgbuild /out /app/ros_msgs
# 同梱 bridge と同じ並べ方 (lib/ と rclpy/) にしてあるので、パスを足すだけでよい。
ENV PYTHONPATH=/app/ros_msgs/rclpy:/isaac-sim/exts/isaacsim.ros2.bridge/jazzy/rclpy:/app
ENV LD_LIBRARY_PATH=/app/ros_msgs/lib:/isaac-sim/exts/isaacsim.ros2.bridge/jazzy/lib:${LD_LIBRARY_PATH}
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
COPY assets/cyclonedds.xml /cyclonedds.xml
ADD assets/ros_entrypoint.isaacsim.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

# ---- アプリ本体 ---------------------------------------------------------------
WORKDIR /app
ADD scripts/hsr.py /app/hsr.py
ADD scripts/hsr_params.py /app/hsr_params.py
ADD scripts/hsr_math.py /app/hsr_math.py
ADD scripts/hsr_kinematics.py /app/hsr_kinematics.py
ADD scripts/hsr_action_servers.py /app/hsr_action_servers.py
ADD scripts/hsr_sensors.py /app/hsr_sensors.py
ADD scripts/hsr_physics.py /app/hsr_physics.py
ADD scripts/hsr_grasp.py /app/hsr_grasp.py
ADD scripts/hsr_base_drive.py /app/hsr_base_drive.py
ADD scripts/hsr_hsrc_ex.py /app/hsr_hsrc_ex.py
# semu.robotics.ros2_bridge (git submodule, MIT). hsr.py adds its src/ to sys.path.
ADD 3rdparty/semu.robotics.ros2_bridge/src /app/3rdparty/semu.robotics.ros2_bridge/src
ADD 3rdparty/semu.robotics.ros2_bridge/LICENSE /app/3rdparty/semu.robotics.ros2_bridge/LICENSE
ADD scripts/launch_isaacsim.py /app/launch_isaacsim.py
ADD scripts/task_config.py /app/task_config.py
ADD scripts/drawers.py /app/drawers.py
ADD scripts/arena_cameras.py /app/arena_cameras.py
ADD scripts/construct_environment.py /app/construct_environment.py
ADD scripts/object_placement.py /app/object_placement.py
ADD scripts/people_spawn.py /app/people_spawn.py
ADD scripts/furniture_spawn.py /app/furniture_spawn.py
ADD scripts/fetch_isaac_offline_assets.py /app/fetch_isaac_offline_assets.py
ADD scripts/dressing_presets.py /app/dressing_presets.py
ADD scene_dressing /app/scene_dressing
ADD configs /app/configs
ADD usd /app/usd
ADD worlds /app/worlds
# プレースホルダテクスチャを焼き込んで、マウントなしでも動くようにする
ADD configs/textures /data/textures

ENV NVIDIA_VISIBLE_DEVICES=${NVIDIA_VISIBLE_DEVICES:-all}
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y
ENV PYTHONUNBUFFERED=1

ENTRYPOINT [ "/ros_entrypoint.sh" ]

CMD [ "/isaac-sim/python.sh", "/app/launch_isaacsim.py"]
