#
# Isaac Sim 5.1 + ROS 2 Jazzy (Isaac 同梱の rclpy を使う。このブランチは Jazzy 専用)
#
# 版の前提:
#   * Isaac Sim 5.1.0 は Ubuntu 24.04 (noble) / Python 3.11。CUDA 12.8 以降の
#     ドライバ要件のため 4.5.0 は使わない。
#   * noble の apt にある ros-jazzy-* は Python 3.12 向けで、Isaac の 3.11 からは
#     rclpy の拡張 (.so) が読めない。
#   * Isaac 5.1 は /isaac-sim/exts/isaacsim.ros2.bridge/jazzy/ に Python 3.11 向けの
#     rclpy と rmw (cyclonedds / fastrtps) を同梱している。
#     → ROS は apt で入れず、同梱物に PYTHONPATH / LD_LIBRARY_PATH を通すだけ。
#
# 同梱に無いもの (msgbuild ステージで Python 3.11 向けに建てる):
#   * control_msgs          FollowJointTrajectory / GripperCommand (MoveIt ↔ sim)
#   * tmc_control_msgs      GripperApplyEffort (hsr-project/tmc_realtime_control)
#   * tmc_wrs_gazebo_worlds randomizer (純 Python, ry0hei-kobayashi/tmc_wrs_gazebo)
#   gazebo_msgs (旧 /gazebo/* サービス) は同梱の simulation_interfaces に、tf_transformations は
#   robot/hsr/quat.py の純 Python 実装に置き換えたので建てない (2026-10-12)。
#   建てる場所 (ros:jazzy + python3.11 venv) と使う場所 (Isaac, py3.11) を分ける。
#   同梱 bridge には lib/ と rclpy/ しか無く CMake 側が丸ごと欠けているので、
#   Isaac コンテナの中ではメッセージを建てられない。手順は env_docker/build_ros_msgs_py311.sh。
#
# 実行ユーザ: ベースイメージは uid 1234 (isaac-sim) だが、ホストの
# ~/.hsr-omniverse/cache を bind mount して書くために root で走らせる
# (4.5 時代と同じ運用。キャッシュの mount 先も /root/... のまま)。

# ---------------------------------------------------------------------------
# stage 1: Python 3.11 向けに ROS メッセージを建てる
# ---------------------------------------------------------------------------
FROM ros:jazzy-ros-base AS msgbuild
ENV ROS_DISTRO=jazzy

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# python3-packaging: colcon 本体は 3.10 で走る。packaging が無いと起動時に落ちる。
# deadsnakes PPA は add-apt-repository を使わず手で登録する。add-apt-repository は
# api.launchpad.net を叩くが、環境によってはそこだけ繋がらずタイムアウトする
# (ppa.launchpadcontent.net / keyserver.ubuntu.com は通る)。
ARG DEADSNAKES_KEY=F23C5A6CF475977595C89F51BA6932366A755776
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg \
    && curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${DEADSNAKES_KEY}" \
        | gpg --dearmor -o /usr/share/keyrings/deadsnakes.gpg \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/keyrings/deadsnakes.gpg] https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/deadsnakes.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv \
        build-essential cmake \
        python3-colcon-common-extensions \
        python3-packaging \
        ros-${ROS_DISTRO}-rosidl-default-generators \
        ros-${ROS_DISTRO}-action-msgs \
        ros-${ROS_DISTRO}-trajectory-msgs \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-geometry-msgs \
        ros-${ROS_DISTRO}-std-msgs \
        ros-${ROS_DISTRO}-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

# 生成器を 3.11 で走らせるのに要る純 Python でない依存。
# lark は apt の Jazzy (python3-lark 1.1.9) と同じ版にする。旧 lark-parser 0.12 は control_msgs 5.10 の
# ExecuteMotionPrimitiveSequence.idl で UnboundLocalError (iter_subtrees の queue) を起こす。
# system の python3.11 に直接 pip すると /usr/lib/python3/dist-packages の
# packaging を消して colcon (3.10) が起動しなくなるので venv に閉じ込める。
RUN python3.11 -m venv /py311 \
    && /py311/bin/pip install --no-cache-dir --upgrade pip \
    && /py311/bin/pip install --no-cache-dir empy==3.3.4 lark==1.1.9 numpy catkin_pkg

WORKDIR /ws/src
# control_msgs は ros2 コンテナの apt (ros-jazzy-control-msgs) と同じ版に固定する (型ハッシュを揃えるため)。
# apt 側を上げたらここも合わせる: docker run --rm --entrypoint bash hsr-omniverse-ros2:jazzy -lc 'dpkg -s ros-jazzy-control-msgs | grep Version'
ARG CONTROL_MSGS_VERSION=5.10.0
RUN git clone -q --depth 1 -b ${CONTROL_MSGS_VERSION} https://github.com/ros-controls/control_msgs.git \
    && git clone -q --depth 1 -b ${ROS_DISTRO} https://github.com/hsr-project/tmc_realtime_control.git \
    && git clone -q --depth 1 -b ${ROS_DISTRO} https://github.com/ry0hei-kobayashi/tmc_wrs_gazebo.git

COPY env_docker/build_ros_msgs_py311.sh /build_ros_msgs_py311.sh
RUN bash /build_ros_msgs_py311.sh

# ---------------------------------------------------------------------------
# stage 2: Isaac Sim 5.1
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/isaac-sim:5.1.0 AS isaac-sim

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# apt と /root 配下のキャッシュ書き込みのため root で走らせる (冒頭のコメント参照)。
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget git \
    && rm -rf /var/lib/apt/lists/*

# tmc_wrs_gazebo_worlds の randomizer が scipy を使う。
RUN /isaac-sim/python.sh -m pip install --no-cache-dir scipy

# ---- ROS 2 Jazzy: Isaac 同梱物 + 自前で建てたメッセージ ---------------------
ENV ROS_DISTRO=jazzy \
    ROS_VERSION=2 \
    ISAAC_ROS2_BRIDGE=/isaac-sim/exts/isaacsim.ros2.bridge/jazzy
COPY --from=msgbuild /out /app/ros_msgs
# 同梱 bridge と同じ並べ方 (lib/ と rclpy/) にしてあるので、パスを足すだけでよい。
ENV PYTHONPATH=/app/ros_msgs/rclpy:/isaac-sim/exts/isaacsim.ros2.bridge/jazzy/rclpy
ENV LD_LIBRARY_PATH=/app/ros_msgs/lib:/isaac-sim/exts/isaacsim.ros2.bridge/jazzy/lib:${LD_LIBRARY_PATH}
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
COPY assets/cyclonedds.xml /cyclonedds.xml
ADD env_docker/ros_entrypoint.isaacsim.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

# ---- アプリ本体 ---------------------------------------------------------------
WORKDIR /app
# Isaac 側のコードは Python パッケージ hsr_omniverse_sim (リポジトリ直下) として Isaac の Python に editable install する。
# これで PYTHONPATH に /app を足す必要が無くなり、compose が ../hsr_omniverse_sim を /app/hsr_omniverse_sim に bind mount すれば
# 編集が再ビルド無しで反映される (ros2 側の --symlink-install と同じ考え方)。
ADD pyproject.toml /app/pyproject.toml
ADD hsr_omniverse_sim /app/hsr_omniverse_sim
RUN /isaac-sim/python.sh -m pip install --no-cache-dir --no-deps --no-build-isolation -e /app
# semu.robotics.ros2_bridge (git submodule, MIT). robot/hsr/action_servers.py adds its src/ to sys.path.
ADD 3rdparty/semu.robotics.ros2_bridge/src /app/3rdparty/semu.robotics.ros2_bridge/src
ADD 3rdparty/semu.robotics.ros2_bridge/LICENSE /app/3rdparty/semu.robotics.ros2_bridge/LICENSE
# 外部 USD (hsrb / wrs_models は submodule)。compose が ../models を /app/models に live mount して上書きする。
# config/ と data/ はパッケージ hsr_omniverse_sim の中 (上の ADD に含まれる)。
ADD models /app/models
ENV HSR_MODELS_DIR=/app/models
# プレースホルダテクスチャを焼き込んで、マウントなしでも動くようにする
ADD hsr_omniverse_sim/config/textures /data/textures

ENV NVIDIA_VISIBLE_DEVICES=${NVIDIA_VISIBLE_DEVICES:-all}
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y
ENV PYTHONUNBUFFERED=1

ENTRYPOINT [ "/ros_entrypoint.sh" ]

CMD [ "/isaac-sim/python.sh", "-m", "hsr_omniverse_sim.launch_isaacsim"]
