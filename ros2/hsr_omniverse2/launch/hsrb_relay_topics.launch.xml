<launch>
  <arg name="use_sim_time" default="true" />

  <let name="rgb_topic_prefix" value="/head_rgbd_sensor/rgb" />
  <let name="depth_topic_prefix" value="/head_rgbd_sensor/depth_registered" />
  <let name="r_stereo_topic_prefix" value="/head_r_stereo_camera" />
  <let name="l_stereo_topic_prefix" value="/head_l_stereo_camera" />

  <node_container namespace="$(var rgb_topic_prefix)" pkg="rclcpp_components" exec="component_container" name="nodelet_manager">
    <composable_node namespace="$(var rgb_topic_prefix)" pkg="image_proc" plugin="image_proc::DebayerNode" name="debayer"/>
  </node_container>

  <node_container namespace="$(var depth_topic_prefix)" pkg="rclcpp_components" exec="component_container" name="nodelet_manager">
    <composable_node namespace="$(var depth_topic_prefix)" pkg="depth_image_proc" plugin="depth_image_proc::PointCloudXyzrgbNode" name="pointcloud_xyzrgb">
      <!-- Isaac Sim publishes depth image_rect_raw as BEST_EFFORT (sensor
           data QoS, needed for cross-PC fragmentation). camera_info stays
           RELIABLE because depth_image_proc subscribes to it via
           message_filters which does NOT honor qos_overrides params. -->
      <param name="qos_overrides./head_rgbd_sensor/depth_registered/image_rect_raw.subscription.reliability" value="best_effort"/>
      <remap from="rgb/camera_info" to="/head_rgbd_sensor/depth_registered/camera_info"/>
      <remap from="rgb/image_rect_color" to="/head_rgbd_sensor/rgb/image_rect_color"/>
      <remap from="depth_registered/image_rect" to="/head_rgbd_sensor/depth_registered/image_rect_raw"/>
      <remap from="points" to="/head_rgbd_sensor/depth_registered/rectified_points"/>
    </composable_node>
  </node_container>

  <!-- xtion rgb -->
  <node name="rgb_raw_image_pub" pkg="topic_tools" exec="relay"
  args="$(var rgb_topic_prefix)/image_rect_color $(var rgb_topic_prefix)/image_raw">
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <node name="rgb_rect_mono_image_pub" pkg="topic_tools" exec="relay"
  args="$(var rgb_topic_prefix)/image_mono $(var rgb_topic_prefix)/image_rect_mono">
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <!-- l_stereo -->
  <node name="l_stereo_raw_image_pub" pkg="topic_tools" exec="relay"
  args="$(var l_stereo_topic_prefix)/image_rect_color $(var l_stereo_topic_prefix)/image_raw" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <!-- r_stereo -->
  <node name="r_stereo_raw_image_pub" pkg="topic_tools" exec="relay"
  args="$(var r_stereo_topic_prefix)/image_rect_color $(var r_stereo_topic_prefix)/image_raw" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <!-- xtion depth -->
  <node name="depth_raw_image_pub" pkg="topic_tools" exec="relay"
  args="$(var depth_topic_prefix)/image_rect_raw $(var depth_topic_prefix)/image_raw" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <node name="depth_hw_float_image_pub" pkg="topic_tools" exec="relay"
  args="$(var depth_topic_prefix)/image_rect_raw $(var depth_topic_prefix)/hw_registered/image_float" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <node name="depth_hw_rect_image_pub" pkg="topic_tools" exec="relay"
  args="$(var depth_topic_prefix)/image_rect_raw $(var depth_topic_prefix)/hw_registered/image_rect" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <node name="depth_hw_rect_raw_image_pub" pkg="topic_tools" exec="relay"
  args="$(var depth_topic_prefix)/image_rect_raw $(var depth_topic_prefix)/hw_registered/image_rect_raw" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <!-- xtion points -->
  <node name="normal_point_cloud_pub" pkg="topic_tools" exec="relay"
  args="$(var depth_topic_prefix)/rectified_points $(var depth_topic_prefix)/points" >
    <param name="lazy" value="true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
</launch>
