<sdf version='1.7'>
  <world name='default'>
    <!-- ============================================================ -->
    <!-- Restaurant Challenge 用の最小ワールド (壁なし・広い空間)        -->
    <!-- ============================================================ -->
    <!-- 机・椅子は configs/tasks/restaurant/placement.yaml の furniture:    -->
    <!-- セクションで「本物のメッシュ USD」として置く (furniture_spawn.py)。  -->
    <!-- このワールドは「床」だけを用意し、外壁は置かない (広い空間で使う)。   -->
    <!-- <include> が無いので dressing (床/背景/照明) は既定サイズ (約15m四方) -->
    <!-- の広い床になる。robot/furniture/people は placement.yaml で配置する。 -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
              <ode/>
            </contact>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-3.0 0.0 6.0 0 1.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- 外壁 (高さ4.5m,厚さ0.1m)。自己位置推定用に4辺を囲う。部屋: X=-7〜8, Y=-6.5〜6.5。 -->
    <!-- 高さを変えるとき: pose の3番目(中心Z=高さの半分)と scale の3番目(高さ)を一緒に直す。 -->
    <include><uri>model://unit_box</uri><name>wall_north</name><pose>0.5 6.5 2.25 0 0 0</pose><scale>15.0 0.1 4.5</scale></include>
    <include><uri>model://unit_box</uri><name>wall_south</name><pose>0.5 -6.5 2.25 0 0 0</pose><scale>15.0 0.1 4.5</scale></include>
    <include><uri>model://unit_box</uri><name>wall_east</name><pose>8.0 0.0 2.25 0 0 0</pose><scale>0.1 13.0 4.5</scale></include>
    <include><uri>model://unit_box</uri><name>wall_west</name><pose>-7.0 0.0 2.25 0 0 0</pose><scale>0.1 13.0 4.5</scale></include>
  </world>
</sdf>
